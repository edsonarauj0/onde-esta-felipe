# ==============================================================================
# Onde está o Felipe? — Variáveis de Ambiente
# Copie para .env.local para desenvolvimento local.
# Em produção, configure no painel da Vercel (NUNCA comite chaves reais!).
# ==============================================================================

# --- Firebase Client (públicas, seguras para o navegador) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional: preencha apenas se o ID do banco Firestore não for "(default)" (ex.: default)
NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# --- Mapa (opcional: sem MapTiler usa OpenFreeMap automaticamente) ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- Modo Demo (opcional: 'true' força modo demonstração local) ---
NEXT_PUBLIC_DEMO_MODE=

# --- Firebase Admin SDK (SOMENTE SERVIDOR) ---
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_CLIENT_EMAIL=
# Dica: na Vercel, cole a chave privada inteira ou com \n escapado
FIREBASE_PRIVATE_KEY=

# --- Claude / Anthropic API (SOMENTE SERVIDOR - parser de PDF) ---
ANTHROPIC_API_KEY=
# Modelo padrão: claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenSky Network (SOMENTE SERVIDOR - 4.000 créditos/dia registrados) ---
# Autenticação atual (OAuth2 Client Credentials - recomendado pela OpenSky):
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Autenticação legada (opcional, se conta antiga ainda usar):
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
