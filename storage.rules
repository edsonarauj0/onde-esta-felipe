rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // PDFs originais da escala: somente o admin pode ler e escrever
    match /escalas/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
